# Production environment configuration template
# Copy to .env.production and provide real, high-entropy secrets.
# NEVER commit the real .env.production file.

# PostgreSQL configuration
POSTGRES_DB=datapulse_prod
POSTGRES_USER=datapulse_prod_user
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_a_strong_password

# Symfony Backend configuration
# Generate with: openssl rand -hex 16
APP_SECRET=replace_with_a_secure_symfony_app_secret
APP_ENV=prod
CORS_ALLOW_ORIGIN=^https://(yourdomain\.com|app\.yourdomain\.com)$
# Max upload size (50 MiB default)
MAX_UPLOAD_SIZE=52428800

# Data Engine configuration
DATA_ENGINE_ENVIRONMENT=prod
# Max profilable size (25 MiB default)
MAX_PROFILABLE_BYTES=26214400

# Frontend public port (default HTTP 80, behind TLS termination proxy such as Cloudflare, Traefik or Caddy)
FRONTEND_PORT=80
