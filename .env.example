# Copy to .env and adjust for local use. Never commit the real .env file.

POSTGRES_DB=datapulse
POSTGRES_USER=datapulse
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5434

BACKEND_PORT=8020
DATABASE_URL=postgresql://datapulse:changeme@postgres:5432/datapulse?serverVersion=16&charset=utf8
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
# Max accepted dataset upload size, in bytes (50 MiB default).
MAX_UPLOAD_SIZE=52428800

DATA_ENGINE_PORT=8021
DATA_ENGINE_URL=http://data-engine:8001
# Max size, in bytes, of a file the data engine will load into memory to
# profile (independent from — and expected to stay <= — MAX_UPLOAD_SIZE).
MAX_PROFILABLE_BYTES=26214400

FRONTEND_PORT=4210

# Access Control: authorized registration access keys (comma-separated).
# Users must provide a valid key to register. Contact Enirack on GitHub or email to request access.
DATAPULSE_INVITE_KEYS=DP-DEMO-2026,DP-VIP-ACCESS
