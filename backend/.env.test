# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Small on purpose so the oversized-upload test doesn't need a huge fixture.
MAX_UPLOAD_SIZE=20000
# Keep test-run uploads out of the dev storage directory entirely.
DATASET_STORAGE_DIR=%kernel.project_dir%/var/storage_test/datasets
DATASET_TMP_DIR=%kernel.project_dir%/var/storage_test/tmp
DATAPULSE_INVITE_KEYS=DP-DEMO-2026,DP-TEST-KEY
